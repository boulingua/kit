# Hugo build output + module cache
/public/
/resources/
.hugo_build.lock

# Node (only if a course adds the optional discovery-network graph)
/node_modules/

# LaTeX build artifacts (materials are generated locally, committed as PDF)
_materials/build/
*.aux
*.log
*.out
*.toc
*.nav
*.snm
*.vrb

# TTS/audio cache (audio OGG is committed; hashes are not)
*.hash

# OS / editor / Python cruft
.DS_Store
Thumbs.db
*.swp
*~
__pycache__/
*.pyc
.venv/

# Local build output: the example site, and the flat _materials/ tree the
# LaTeX Makefile assembles to compile in.
build/

# Font build scratch. The upstream sources in design/fonts/src/ ARE committed
# (pruned to the faces fonts.yaml names) so the build is reproducible offline.
design/fonts/src/*.zip
design/fonts/src/__MACOSX/
