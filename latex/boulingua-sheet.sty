% boulingua-sheet.sty — worksheet style in the boulingua design language.
% Compile with XeLaTeX or LuaLaTeX (fontspec). Self-contained: bundles the
% Source Sans 3 / JetBrains Mono fonts and the boulingua logo.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{boulingua-sheet}[2026/07/21 boulingua worksheet style]

\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage[a4paper,top=2.4cm,bottom=2.6cm,left=2.2cm,right=2.2cm]{geometry}
\RequirePackage{titlesec}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{tcolorbox}
\RequirePackage{graphicx}
\RequirePackage{eso-pic}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{fancyhdr}
\RequirePackage{changepage}
\RequirePackage{hyperref}
% PDF metadata — attribute the author in the file's core properties.
% ── Document metadata ───────────────────────────────────────────────────────
% /Author was the only field any of these carried, and the attribution gate
% greps /Author alone — so 432 committed PDFs passed while shipping with no
% title, no subject and no keywords. The gate is being widened; these are the
% fields it will want. Set the per-document ones with \blgsetmeta.
\hypersetup{
  pdfauthor={S. Le Boulanger},
  pdfcreator={boulingua kit},
  pdfproducer={boulingua kit},
  hidelinks}
% \blgsetmeta{<course long name>}{<comma-separated keywords>}
\newcommand{\blgsetmeta}[2]{\hypersetup{pdfsubject={#1},pdfkeywords={#2}}}

% Body indent: the title bar + accent rule run the full text width; the
% worksheet content sits inside a slightly indented column beneath them.
\newlength{\blgbodyindent}\setlength{\blgbodyindent}{8mm}
\newenvironment{sheetbody}%
  {\begin{adjustwidth}{\blgbodyindent}{0pt}}%
  {\end{adjustwidth}}

% ── Palette ─────────────────────────────────────────────────────────────────
% Every colour comes from boulingua-tokens, generated from design/tokens.yaml.
% This block used to carry 43 \definecolor literals — the same 43 that sat in
% the sibling .sty file, kept in agreement by hand. They were not in agreement:
% Persian reached the CSS side and neither of these, so `pfa` had a web accent
% and no print accent. There is now one source, and gate A7 fails any
% \definecolor outside the generated package.
\RequirePackage{boulingua-tokens}
% \blglangmark[height] draws the language's abstract icon (accent-filled);
% it is a no-op until \blgsetlang{code} points it at brand/icons/<code>.pdf.
\newcommand{\blglangmark}[1][12mm]{}
% \blgsetui{<polyglossia language>} — the INSTRUCTION language.
%
% Every page is German instructions around target-language content, and those
% are two different languages with two different typographic conventions. The
% design spec had no way to say that on the print side, so a Greek worksheet
% and its German task rubric were indistinguishable to the renderer.
%
% Defaults to german and is a no-op in the four shipped script tiers: it
% records the distinction now so unit sources carry it, and becomes a real
% \setmainlanguage when polyglossia lands with bidi at wave 5 (ADR-0008).
\usepackage{etoolbox}   % \ifdefstring, for the UI strings below
\newcommand{\blguilang}{german}

% Printed strings, following the instruction language. The answer box was
% labelled with a hardcoded English "Solutions" and shipped that way on all 56
% German worksheets that have one — the only English word on a page otherwise
% entirely in German, sitting over the answers. The mechanism to fix it existed
% here already; only the string did not use it.
%
% These stay in step with kit/i18n/<lang>.yaml. When D5's pre-flight reads the
% i18n file it fails on a missing key rather than printing an English word into
% a German worksheet.
\newcommand{\blgui@solutions}{Solutions}
\newcommand{\blgui@vocab}{Vocabulary}
\newcommand{\blgui@worksheet}{Worksheet}
\newcommand{\blgsetui}[1]{\renewcommand{\blguilang}{#1}%
  % Reset to the English defaults FIRST. Without this each branch only ever
  % adds, so \blgsetui{french} followed by \blgsetui{english} left the French
  % strings in place — a setter that cannot set back is not a setter, and the
  % failure only shows in the second call, which no single-language sheet makes.
  \renewcommand{\blgui@solutions}{Solutions}%
  \renewcommand{\blgui@vocab}{Vocabulary}%
  \renewcommand{\blgui@worksheet}{Worksheet}%
  \ifdefstring{\blguilang}{german}{%
    \renewcommand{\blgui@solutions}{L\"osungen}%
    \renewcommand{\blgui@vocab}{Wortschatz}%
    \renewcommand{\blgui@worksheet}{Arbeitsblatt}}{}%
  \ifdefstring{\blguilang}{french}{%
    \renewcommand{\blgui@solutions}{Corrig\'e}%
    \renewcommand{\blgui@vocab}{Vocabulaire}%
    \renewcommand{\blgui@worksheet}{Fiche}}{}}
% The default is german, so apply it once at load rather than waiting for a
% caller — a sheet that never calls \blgsetui must not silently print English.
\blgsetui{german}

\newcommand{\blgsetlang}[1]{\colorlet{blgaccent}{acc-#1}\colorlet{blgaccenthover}{acch-#1}%
  \renewcommand{\blglangmark}[1][12mm]{\includegraphics[height=##1]{brand/icons/#1.pdf}}}
\color{blgfg}

% ── Fonts ───────────────────────────────────────────────────────────────────
% Extension is .otf now: these are cut from the upstream Adobe release, not the
% Google Fonts `latin,latin-ext` repackaging that shipped before. That one
% carried 781 codepoints with no Greek and no Cyrillic, and declared every
% weight "Source Sans 3 ExtraLight" in its name table, which is why every
% committed worksheet embeds /BUEMMA+SourceSans3ExtraLight-Regular.
%
% ItalicFont is set for the first time. There was no italic face anywhere in
% the org, so all 13,576 emphasis spans across the three live courses were
% synthesised obliques. For Cyrillic that is not merely ugly: а, т and д have
% different italic constructions, so a synthesised oblique renders the wrong
% letterforms.
\setmainfont{SourceSans3}[Path=fonts/, Extension=.otf,
  UprightFont=*-Regular, ItalicFont=*-It,
  BoldFont=*-Bold, BoldItalicFont=*-BoldIt]
% \setsansfont, and this is the fix for a defect the italic work uncovered:
% \setmainfont sets \rmfamily, but beamer's default document family is
% \sffamily. Every committed deck in the org — 156 fle + 60 daf — is therefore
% typeset in Latin Modern Sans, with Source Sans 3 appearing only where
% \blgsemibold is called explicitly. Verified in the artefacts: they embed
% LMSans10-Regular and LMSans10-Oblique for body text.
\setsansfont{SourceSans3}[Path=fonts/, Extension=.otf,
  UprightFont=*-Regular, ItalicFont=*-It,
  BoldFont=*-Bold, BoldItalicFont=*-BoldIt]
\newfontfamily\blgsemibold{SourceSans3-Semibold}[Path=fonts/, Extension=.otf,
  ItalicFont=SourceSans3-SemiboldIt]
% Scale=0.884 is not a preference. JetBrains Mono's x-height measures 0.550 em
% against Source Sans 3's 0.486 — 13% larger — so at the same nominal size code
% sets visibly bigger than the prose around it. The number is measured in
% design/fonts.yaml and the SAME value produces the CSS size-adjust, so web and
% print cannot drift apart.
\setmonofont{JetBrainsMono-Regular}[Path=fonts/, Extension=.ttf, Scale=0.884]
\newfontfamily\blgmarker{PermanentMarker-Regular}[Path=fonts/, Extension=.ttf]
% Both media resolve to the same family by default rather than by accident.
\renewcommand{\familydefault}{\sfdefault}

% ── Section styling ─────────────────────────────────────────────────────────
\titleformat{\section}{\blgsemibold\Large\color{blgfg}}{\thesection.}{0.5em}{}[{\color{blgrule}\titlerule[1pt]}]
\titleformat{\subsection}{\blgsemibold\large\color{blgaccenthover}}{}{0em}{}
\titlespacing*{\section}{0pt}{1.4em}{0.6em}
\setlist{leftmargin=1.4em,itemsep=0.25em,topsep=0.3em}

% ── Level badge (CEFR / Niveau) ─────────────────────────────────────────────
\newcommand{\blgbadge}[2][blgaccent]{%
  \tikz[baseline=(b.base)]\node[fill=#1,text=white,rounded corners=3pt,
    inner xsep=6pt,inner ysep=2pt,font=\blgsemibold\footnotesize](b){#2};}

% ── Worksheet header ────────────────────────────────────────────────────────
% \worksheetheader{Title}{Subtitle line}{Badge label}{badge color}
\newcommand{\worksheetheader}[4]{%
  \gdef\blgtitle{#1}%
  % Also set the PDF /Title. The deck has always done this from
  % \inserttitle; the worksheet did not, so every worksheet PDF shipped with
  % an empty title while the attribution gate — which greps /Author only —
  % stayed green. Gate D2 checks both.
  \hypersetup{pdftitle={#1}}%
  \thispagestyle{empty}%
  {\blgsemibold\LARGE\color{blgfg} #1\hfill\raisebox{-3.2mm}[0pt][0pt]{\blglangmark[11mm]}\par}%
  \vspace{0.35em}%
  % Level (Niveau) as plain text — no coloured highlight. #4 (badge colour)
  % is accepted for signature compatibility but intentionally unused here.
  {\color{blgmuted}\normalsize #2 \hfill {\blgsemibold\color{blgfg}#3}}\par
  \vspace{0.35em}{\color{blgaccent}\rule{\linewidth}{1.4pt}}\par
  \vspace{1.1em}}

% ── Answer-key box ──────────────────────────────────────────────────────────
\newtcolorbox{blganswers}{colback=blgsurface,colframe=blgrule,boxrule=0.6pt,
  arc=3pt,left=8pt,right=8pt,top=6pt,bottom=6pt,
  title={\blgsemibold\small \blgui@solutions},fonttitle=\color{blgfg},
  coltitle=blgfg,attach title to upper=\ }

% Writing lines for hand-written answers
\newcommand{\blglines}[1][3]{\par\vspace{0.3em}%
  \foreach \n in {1,...,#1}{\noindent\color{blgrule}\rule{\linewidth}{0.4pt}\par\vspace{1.1em}}}

% ── Watermark: icon + © author · title, centred at the foot of every page ───
\newcommand{\blgtitle}{}   % set by \worksheetheader to the sheet's title
\newcommand{\blgwatermark}{%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=south,inner sep=0pt] at ($(current page.south)+(0,10mm)$)
      {\raisebox{-1.15mm}{\includegraphics[height=4.4mm]{assets/boulingua-logo.png}}%
       \hspace{1.6mm}{\blgsemibold\footnotesize\color{blgmuted}%
         \textcopyright\ S.~Le Boulanger \ \textbullet\ \blgtitle}};
  \end{tikzpicture}}
\AddToShipoutPictureFG{\blgwatermark}

% Footer: page number, muted, right
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyfoot[R]{\color{blgmuted}\footnotesize\thepage}
\endinput
