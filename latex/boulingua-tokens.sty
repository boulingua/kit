% \tl{} — the print counterpart of the {{< tl >}} shortcode. For Latin,
% Greek, Cyrillic and CJK it is the identity: those scripts need no
% direction change and the glyphs come from the same face. It exists now,
% as a no-op, so unit sources written today already carry the markup and do
% not need a pass over every file when bidi lands at wave 5, where this is
% redefined to \textarabic{} / \textpersian{}.
\providecommand{\tl}[1]{#1}

